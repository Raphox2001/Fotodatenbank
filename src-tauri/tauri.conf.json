{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fotodatenbank",
  "version": "0.2.0",
  "identifier": "de.fotodatenbank.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fotodatenbank",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "incognito": true,
        "contentProtected": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: vault: http://vault.localhost",
        "media-src": "'self' vault: http://vault.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "bin/ffmpeg.exe": "bin/ffmpeg.exe",
      "bin/ffprobe.exe": "bin/ffprobe.exe"
    },
    "publisher": "Fotodatenbank",
    "shortDescription": "Verschlüsselte Fotodatenbank",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3NjFDQTU1OTlDMEVFODgKUldTSTdzQ1pWY3BoOTlkeGVzbGV6NWhsdnBHOGxUbzdhNWg0RC9YQ1R0UDMwSmRWZmNWeTM4RHIK",
      "endpoints": [
        "https://github.com/Raphox2001/Fotodatenbank/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
